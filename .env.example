# ── Required ──────────────────────────────────────────────────────────────────
PORT=4999

# At least one AI provider is required (Groq is primary, OpenRouter is fallback)
GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# Supabase (required for auth, credit tracking, and account management)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# ANON_CREDITS_MAX=2  # guest (not signed in) transcript credits per 7-day window
# AI_REQUIRE_AUTH=0   # set to 1 to force sign-in for all AI endpoints
# AI_ANON_RPM=6       # anonymous AI requests per minute per IP
# AI_AUTH_RPM=20      # signed-in AI requests per minute per user
# ANON_AI_MAX_PER_DAY=24  # anonymous AI requests per day per IP

# ── Optional ──────────────────────────────────────────────────────────────────

# YouTube cookies (bypasses age-restriction / login-required videos)
# Paste the contents of your exported Netscape cookies.txt here
# YT_COOKIES=

# Residential proxy (bypasses YouTube datacenter IP blocking)
# YT_PROXY_URL=http://user:pass@proxy.host:port
# WEBSHARE_PROXY_URL=http://user:pass@proxy.host:port

# AI fallback audio quality tuning (optional)
# 0 = best quality, 9 = smallest file
# YTDLP_AUDIO_QUALITY=0
# YTDLP_AUDIO_FORMAT=bestaudio

# Supadata (alternative transcript provider for Wistia and other platforms)
# SUPADATA_API_KEY=

# YouTube Data API v3 (used by /api/discover for video search)
# YOUTUBE_API_KEY=

# Google Generative AI (optional, unused in current build)
# GOOGLE_AI_API_KEY=
